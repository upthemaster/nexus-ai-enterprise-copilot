        ChatRoute["POST /api/v1/chat"]:::implemented
        CitationRoute["GET /api/v1/citations/:id"]:::implemented
        ConvRoute["/api/v1/conversations/*"]:::implemented
        WorkflowRoute["POST /api/v1/workflows/* & /documents/:id/*"]:::implemented
        EvalRoute["/api/v1/evaluation/* (run, ablation, history)"]:::implemented
    end

    subgraph IngestionSubsystem ["Ingestion Subsystem [IMPLEMENTED]"]
        DocService["DocumentService (app/services/document_service.py)"]:::implemented
        Validator["Validator: Stream Size, Magic Bytes, Traversal (app/ingestion/validator.py)"]:::implemented
        Extractor["Extractor: PDF, DOCX, TXT (app/ingestion/extractor.py)"]:::implemented
        DiskStorage[("Local Upload Storage: data/uploads/")]:::implemented
    end

    subgraph IndexingSubsystem ["Dual-Indexing & Storage Subsystem [IMPLEMENTED]"]
        IndexingService["IndexingService (app/services/indexing_service.py)"]:::implemented
        Chunker["Page-Aware Text Splitter (app/ingestion/chunker.py)"]:::implemented
        Embedder["SentenceTransformer: all-MiniLM-L6-v2 (app/retrieval/embeddings.py)"]:::implemented
        ChromaStore[("ChromaDB Vector Store: data/chroma/ (app/retrieval/vector_store.py)")]:::implemented
        BM25Store[("BM25 Sparse Index: data/bm25_index.json (app/retrieval/bm25_index.py)")]:::implemented
        SQLiteStore[("SQLite Metadata DB: data/nexusai.db (app/db/session.py)")]:::implemented
    end

    subgraph RetrievalSubsystem ["Retrieval & Fusion Subsystem [IMPLEMENTED]"]
        HybridRetriever["Hybrid Retriever (app/retrieval/hybrid.py)"]:::implemented
        RRFusion["Reciprocal Rank Fusion RRF (k=60)"]:::implemented
        Reranker["Cross-Encoder Reranker: ms-marco-MiniLM (app/retrieval/reranker.py)"]:::implemented
    end

    subgraph WorkflowSubsystem ["Workflow & Generation Subsystem [IMPLEMENTED]"]
        ChatService["ChatService (app/services/chat_service.py) [IMPLEMENTED]"]:::implemented
        CitationService["CitationService: Quote Matcher & Inspector [IMPLEMENTED]"]:::implemented
        ConvService["ConversationService: Session Persistence [IMPLEMENTED]"]:::implemented
        LLMAdapter["LLM Provider Adapter: Gemini / OpenAI / Mock [IMPLEMENTED]"]:::implemented
