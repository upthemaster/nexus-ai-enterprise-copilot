    end

    subgraph EvaluationSubsystem ["Evaluation & Benchmarking Subsystem [IMPLEMENTED]"]
        EvalRunner["BenchmarkRunner & Metrics Engine (app/evaluation/benchmarks.py)"]:::implemented
        EvalService["EvaluationService: Historical Runs (app/services/evaluation_service.py)"]:::implemented
        GoldenDataset[("Golden Evaluation Dataset: v1.jsonl & Corpus")]:::implemented
        EvalStore[("Evaluation Run History: data/eval_runs/")]:::implemented
    end

    %% Client to API Connections
    UI -.->|"HTTPS / JSON"| FastAPIApp
    FastAPIApp --> HealthRoute
    FastAPIApp --> UploadRoute
    FastAPIApp --> SearchRoute
    FastAPIApp --> ChatRoute
    FastAPIApp --> CitationRoute
    FastAPIApp --> ConvRoute
    FastAPIApp --> WorkflowRoute
    FastAPIApp --> EvalRoute

    %% Upload Ingestion & Dual-Indexing Flow
    UploadRoute -->|"UploadFile"| DocService
    DocService -->|"Stream & Validate"| Validator
    DocService -->|"Persist bytes"| DiskStorage
    DocService -->|"Extract text & metadata"| Extractor
    DocService -->|"Extracted Pages"| IndexingService
    IndexingService -->|"Recursive Split"| Chunker
    IndexingService -->|"Chunk Texts"| Embedder
    Embedder -->|"Dense 384d Vectors"| ChromaStore
    IndexingService -->|"Dense Upsert"| ChromaStore
    IndexingService -->|"Tokens & Chunks"| BM25Store

    %% Hybrid Search Flow (Day 3)
    SearchRoute -->|"Query & Top_K"| IndexingService
    IndexingService -->|"Hybrid Query"| HybridRetriever
    HybridRetriever -->|"Dense Top_K"| ChromaStore
    HybridRetriever -->|"Sparse Top_K"| BM25Store
    HybridRetriever -->|"Merge & Score"| RRFusion
    RRFusion -->|"Ranked Candidates + Debug"| IndexingService

    %% Grounded Chat & Session Flow (Day 4 & 5)
    ChatRoute -->|"ChatRequest"| ChatService
    ChatService <-->|"Session History"| ConvService
    ConvService <-->|"CRUD"| SQLiteStore
    ConvRoute --> ConvService
    CitationRoute --> CitationService
    CitationService --> ChromaStore & BM25Store

    ChatService -->|"Contextualized Query"| HybridRetriever
    HybridRetriever -->|"Top Candidates"| Reranker
    Reranker -->|"Top-K Passages"| ChatService
    ChatService -->|"Delimited Prompt + History"| LLMAdapter
    LLMAdapter -->|"Raw Answer & Tags"| CitationService
    CitationService -->|"Validated Citations & Quotes"| ChatService

    %% Workflow & Orchestration Flow (Day 6)
    WorkflowRoute -->|"WorkflowRequest"| LangGraphOrch
    LangGraphOrch -->|"tool_hybrid_search"| HybridRetriever
    LangGraphOrch -->|"generate"| LLMAdapter

    %% Evaluation & Benchmarking Flow (Day 7)
    EvalRoute --> EvalService
    EvalService --> EvalRunner
    EvalService --> EvalStore
    EvalRunner --> GoldenDataset
    EvalRunner --> ChromaStore
    EvalRunner --> BM25Store
    EvalRunner --> HybridRetriever
    EvalRunner --> Reranker
    EvalRunner --> LLMAdapter

    subgraph DeploymentSubsystem ["Deployment, Packaging & CI/CD Subsystem [IMPLEMENTED]"]
        DockerCompose["Docker Compose Orchestrator (docker-compose.yml)"]:::implemented
        NginxProxy["Nginx Reverse Proxy & Static Host (frontend/nginx.conf)"]:::implemented
        BEContainer["Backend Container: python:3.10-slim (backend/Dockerfile)"]:::implemented
        FEContainer["Frontend Container: node:20 + nginx:1.27 (frontend/Dockerfile)"]:::implemented
        CIWorkflow["GitHub Actions CI Pipeline (.github/workflows/ci.yml)"]:::implemented
    end

    %% Deployment Connections
    DockerCompose --> BEContainer & FEContainer
    FEContainer --> NginxProxy
    NginxProxy --> UI
    NginxProxy -->|"Proxy /api/v1/"| FastAPIApp
    BEContainer --> FastAPIApp
    CIWorkflow -.->|"Validates"| FastAPIApp & UI & DockerCompose

    %% Legend Subgraph
    subgraph ArchitectureLegend ["Legend"]
        LegImplemented["Solid Green: 100% IMPLEMENTED & VERIFIED (Days 1 through 10 Complete)"]:::implemented
    end

