    %% Dashed/Grey nodes: PLANNED (Future Days)

    subgraph ClientLayer ["Client Layer [IMPLEMENTED]"]
        UI["React SPA (Vite + TypeScript + Tailwind) [IMPLEMENTED]"]:::implemented
    end

    subgraph APILayer ["FastAPI API Layer [IMPLEMENTED]"]
