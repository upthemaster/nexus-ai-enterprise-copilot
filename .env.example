# NexusAI Enterprise Copilot - Environment Configuration
APP_NAME=NexusAI
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Document Ingestion Settings (Day 1)
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "docx", "txt"]
UPLOAD_DIR=./data/uploads

# Text Chunking Settings (Day 2)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embeddings & Vector Storage Settings (Day 2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=nexusai_documents_v1

# Hybrid Retrieval Settings (Day 3)
RRF_K=60
BM25_PERSIST_PATH=./data/bm25_index.json

# Reranking & LLM Settings (Day 4)
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3
EVIDENCE_MIN_SCORE=-6.0
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: OpenAI or Local Compatible Endpoint (vLLM / Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_MODEL=gpt-4o-mini

# Relational Database Settings (Day 5)
SQLITE_DB_PATH=./data/nexusai.db